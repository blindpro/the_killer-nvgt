{
for(uint i=0; i<players.length(); i++)
{
if(players[i].peer_id==id)
{
return i;
}
}
return -1;
}
int get_player_index_from(string name, bool evenhidden=true)
{
for(uint i=0; i<players.length(); i++)
{
if(players[i].name==name)
{
if(!evenhidden&&players[i].hidden>0) continue;
 return i;
}
}
return -1;
}
