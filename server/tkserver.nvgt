#include "includes\include.nvgt"
string version = "0.0";
network n;
network_event e;
uint64 port = 10000;
bool netsetup;
int filterstuff=1;
file fl;

void main()
{
if(!SCRIPT_COMPILED)
{
int q=question("hello","You are running the server from source. Is this just a compilation check?");
if(q==1)
{
alert("okay","it works. Exiting");
exit();
}
else
{
alert("okay","proceeding with normal execution");
}
}
show_window("TK server v"+version);
speak("TK server active");
netsetup=n.setup_server(port, 200, 500);
while(true)
{
refresh_window ();
net_loop();
if(key_pressed(KEY_ESCAPE))
{
exit ();
}
}
}

void net_loop ()
{
network_event e = n.request();
string s;
if(e.type==event_connect)
{
return;
}
if(e.type==event_receive)
{
s = get_event_message(e.message);
}
if (s=="")
{
return;
}
string[] parsed = s.split("|");
if (parsed.length()<1)
{
return;
}
if (parsed[0]=="get_map" && parsed.length() ==2)
{
file f;
f.open ("maps\\"+parsed[1],"rb");
string data = f.read();
f.close();
send_unreliable_x(0,"map|"+data,0);
}
else if(parsed[0]=="newchar" and parsed.length()>3)
{
create_char(parsed[1],parsed[2],parsed[3],e.peer_id,parsed[4]);
}
if(parsed[0]=="login" and parsed.length() > 4)
{
login(parsed[1],parsed[2],parsed[3],e.peer_id,parsed[4]);
}
}
