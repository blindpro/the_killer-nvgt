// Global Variables, for database/server access. 
string IP_LOCALE_API_KEY="182b59aac740c883fe6708530434c7e20215122c5577528881c888dc3349b3f8";
string IP_LOCALE_PHP_URL="http://ims-productions.com/ip_locale.php";
// Temporarily use the free interface for up to 1000 requests per day.
string IP_LOCALE_URL = "https://api.ip2location.io/";
// start of class

class ip_locale
{
// constructer
ip_locale()
{
reset();
}
// reset all variables to default. 
void reset()
{
active=false;
requested=false;
raw_data="";
ip_query="AUTO";
ip_address="";
country_code="";
country_name="";
state="";
city="";
zipcode="";
latitude="";
longitude="";
time_zone="";
}
// set the IP address to geolocate. Passing "AUTO" to the function will determine the location from the clients IP address. 
void set_ip(string ip="AUTO")
{
reset();
ip_query=ip;
active=true;
}
// request. Sends a request out to "www.ipinfodb.com" and fills all variables with location data on success. 
bool request()
{
if(requested==false and active==true)
{
if(ip_query=="AUTO")
{
raw_data=url_get(IP_LOCALE_URL);
}
else
{
raw_data=url_get(IP_LOCALE_URL+"?ip="+ip_query);
}
string error_check_raw=string_to_lower_case(raw_data);
if(string_contains(error_check_raw, "error", 1)>-1 or get_last_error()<0)
{
return false;
}
/* use json
string[] data=string_split(raw_data, ";", false);
if(data.length()<10)
return false;
*/
json_object@ l_js = parse_json(raw_data);
if(l_js.size()<10)
return false;
if(l_js.exists("ip"))
{
if(l_js.is_null("ip"))
ip_address = "unknown";
else
ip_address = l_js["ip"];
}
if(l_js.exists("country_code"))
{
if(l_js.is_null("country_code"))
country_code = "unknown";
else
country_code=l_js["country_code"];
}
if(l_js.exists("country_name"))
{
if(l_js.is_null("country_name"))
country_name = "unknown";
else
country_name=l_js["country_name"];
}
if(l_js.exists("region_name"))
{
if(l_js.is_null("region_name"))
state = "unknown";
else
state=l_js["region_name"];
}
if(l_js.exists("city_name"))
{
if(l_js.is_null("city_name"))
city = "unknown";
else
city=l_js["city_name"];
}
if(l_js.exists("zip_code"))
{
if(l_js.is_null("zip_code"))
zipcode = "unknown";
else
zipcode=l_js["zipcode"];
}
if(l_js.exists("latitude"))
{
if(l_js.is_null("latitude"))
latitude = "unknown";
else
latitude=l_js["latitude"];
}
if(l_js.exists("longitude"))
{
if(l_js.is_null("longitude"))
longitude = "unknown";
else
longitude=l_js["longitude"];
}
if(l_js.exists("time_zone"))
{
if(l_js.is_null("time_zone"))
time_zone = "unknown";
else
time_zone=l_js["time_zone"];
}
active=true;
requested=true;
return true;
}
else
{
return false;
}
}
// below are all of the string functions to retreive the location data. 
string get_ip_address()
{
if(active and requested)
return ip_address;
else
return "";
}
string get_country_code()
{
if(active and requested)
return country_code;
else
return "";
}
string get_country_name()
{
if(active and requested)
return country_name;
else
return "";
}
string get_state()
{
if(active and requested)
return state;
else
return "";
}
string get_city()
{
if(active and requested)
return city;
else
return "";
}
string get_zipcode()
{
if(active and requested)
return zipcode;
else
return "";
}
string get_latitude()
{
if(active and requested)
return latitude;
else
return "";
}
string get_longitude()
{
if(active and requested)
return longitude;
else
return "";
}
string get_time_zone()
{
if(active and requested)
return time_zone;
else
return "";
}

// private variables do not modify! 
private string raw_data;
private bool requested;
private bool active;
private string ip_query;
private string ip_address;
private string country_code;
private string country_name;
private string state;
private string city;
private string zipcode;
private string latitude;
private string longitude;
private string time_zone;

}

//end of class

