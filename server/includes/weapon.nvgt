if(weapons[j].type=="rocketlauncher")
{
spawn_rocket(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
break;
}
/*
if(weapons[j].type=="cannon")
{
spawn_cannonball(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
break;
}
*/
if(weapons[j].type=="rpg7")
{
spawn_rpg(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
break;
}
}
}
for(uint x=0; x<remguns.length(); x++)
{
if(get_3d_distance(rx, ry, weapons[j].z, remguns[x].x, remguns[x].y, remguns[x].z)<=weapons[j].spread and remguns[x].map==weapons[j].map)
{
send_reliable(weapons[j].p.peer_id,"play_s|weaponping.ogg",0);
if(weapons[j].type=="artillery") send_reliable(weapons[j].p.peer_id,"hit "+cn2n(remguns[x].owner)+"'s remote gun "+remguns[x].id,2);
remguns[x].health-=random(weapons[j].mindammage, weapons[j].maxdammage);
play("remgunhit"+random(1, 3), rx, ry, weapons[j].z, weapons[j].map);
remguns[x].hitby=weapons[j].p.name+"'s "+(weapons[j].type=="artillery" ? "tank" : weapons[j].type);
hit=true;
if(weapons[j].type=="grenade")
{
spawn_grenade(remguns[x].x,remguns[x].y,remguns[x].z,remguns[x].dir,remguns[x].map,weapons[j].p.name);
}
if(weapons[j].type=="rocket_launcher")
{
spawn_rocket(remguns[x].x,remguns[x].y,remguns[x].z,remguns[x].dir,remguns[x].map,weapons[j].p.name);spawn_grenade(remguns[x].x,remguns[x].y,remguns[x].z,remguns[x].dir,remguns[x].map,weapons[j].p.name);
}
if(weapons[j].type=="rpg7")
{
spawn_rpg(remguns[x].x,remguns[x].y,remguns[x].z,remguns[x].dir,remguns[x].map,weapons[j].p.name);spawn_grenade(remguns[x].x,remguns[x].y,remguns[x].z,remguns[x].dir,remguns[x].map,weapons[j].p.name);
}
if(weapons[j].type=="gp30")
{
spawn_gp(remguns[x].x,remguns[x].y,remguns[x].z,remguns[x].dir,remguns[x].map,weapons[j].p.name);
}
if(weapons[j].type=="ags30")
{
spawn_ags(remguns[x].x,remguns[x].y,remguns[x].z,remguns[x].dir,remguns[x].map,weapons[j].p.name);
}
if(weapons[j].type=="m79_grenade_launcher")
{
spawn_grenade(remguns[x].x,remguns[x].y,remguns[x].z,remguns[x].dir,remguns[x].map,weapons[j].p.name);
}
}
}
for(uint x=0; x<impact_bombs.length(); x++)
{
if(get_3d_distance(rx, ry, weapons[j].z, impact_bombs[x].x, impact_bombs[x].y, impact_bombs[x].z)<=weapons[j].spread and impact_bombs[x].map==weapons[j].map)
{
impact_bombs[x].health-=random(weapons[j].mindammage, weapons[j].maxdammage);
play("ibombhit"+random(1, 3), rx, ry, weapons[j].z, weapons[j].map);
hit=true;
if(weapons[j].type=="grenade")
{
spawn_grenade(impact_bombs[x].x,impact_bombs[x].y,impact_bombs[x].z,weapons[j].dir,impact_bombs[x].map,weapons[j].p.name);
}
if(weapons[j].type=="rocket_launcher")
{
spawn_rocket(impact_bombs[x].x,impact_bombs[x].y,impact_bombs[x].z,weapons[j].dir,impact_bombs[x].map,weapons[j].p.name);
}
if(weapons[j].type=="rpg7")
{
spawn_rpg(impact_bombs[x].x,impact_bombs[x].y,impact_bombs[x].z,weapons[j].dir,impact_bombs[x].map,weapons[j].p.name);
}
if(weapons[j].type=="gp30")
{
spawn_gp(impact_bombs[x].x,impact_bombs[x].y,impact_bombs[x].z,weapons[j].dir,impact_bombs[x].map,weapons[j].p.name);
}
if(weapons[j].type=="ags30")
{
spawn_ags(impact_bombs[x].x,impact_bombs[x].y,impact_bombs[x].z,weapons[j].dir,impact_bombs[x].map,weapons[j].p.name);
}
if(weapons[j].type=="m79_grenade_launcher")
{
spawn_grenade(impact_bombs[x].x,impact_bombs[x].y,impact_bombs[x].z,weapons[j].dir,impact_bombs[x].map,weapons[j].p.name);
}
}
}
for(uint v=0; v<shelters.length (); v++)
{
if(are_teamed(weapons[j].p.name,shelters[v].owner)) continue;
if(get_3d_distance(weapons[j].x,weapons[j].y,weapons[j].z,shelters[v].x,shelters[v].y,shelters[v].z)<=weapons[j].spread&&shelters[v].map==weapons[j].map and weapons[j].p.name!=shelters[v].owner)
{
string t="";
if(!weapons[j].bullet) t=weapons[j].type;
if(weapons[j].type=="grenade")
{
//t="";
spawn_grenade(shelters[v].x,shelters[v].y,shelters[v].z,shelters[v].facing,shelters[v].map,weapons[j].p.name);
}
if(weapons[j].type=="rocket_launcher")
{
spawn_rocket(shelters[v].x,shelters[v].y,shelters[v].z,shelters[v].facing,shelters[v].map,weapons[j].p.name);
}
if(weapons[j].type=="rpg7")
{
spawn_rpg(shelters[v].x,shelters[v].y,shelters[v].z,shelters[v].facing,shelters[v].map,weapons[j].p.name);
}
if(weapons[j].type=="gp30")
{
spawn_gp(shelters[v].x,shelters[v].y,shelters[v].z,shelters[v].facing,shelters[v].map,weapons[j].p.name);
}
if(weapons[j].type=="ags30")
{
spawn_ags(shelters[v].x,shelters[v].y,shelters[v].z,shelters[v].facing,shelters[v].map,weapons[j].p.name);
}
if(weapons[j].type=="m79_grenade_launcher")
{
spawn_grenade(shelters[v].x,shelters[v].y,shelters[v].z,shelters[v].facing,shelters[v].map,weapons[j].p.name);
}
shelters[v].hit(random(weapons[j].mindammage,weapons[j].maxdammage),weapons[j].p.name+"'s "+weapons[j].type,t);
if(@weapons[j].p!=null)
{
send_reliable(weapons[j].p.peer_id,"play_s|weaponping.ogg",0);
if(weapons[j].type=="artillery") send_reliable(weapons[j].p.peer_id,"hit "+cn2n(shelters[v].owner)+"'s shelter",2);
}
hit=true;
}
}
for(uint v=0; v<vs.length (); v++)
{
if(get_2d_distance(weapons[j].x,weapons[j].y,vs[v].x,vs[v].y)<=weapons[j].spread&&vs[v].map==weapons[j].map&&vs[v].owner!=weapons[j].p.name and ((vs[v].z>=weapons[j].z&&(vs[v].z<=(weapons[j].z+8))&&weapons[j].type!="artillery")||(vs[v].z>=weapons[j].z&&(vs[v].z<=(weapons[j].z+10))&&weapons[j].type=="artillery")))
{
string t="";
if(!weapons[j].bullet) t=weapons[j].type;
if(weapons[j].type=="grenade")
{
t="";
spawn_grenade(vs[v].x,vs[v].y,vs[v].z,vs[v].facing,vs[v].map,weapons[j].p.name);
}
if(weapons[j].type=="rocket_launcher")
{
spawn_rocket(vs[v].x,vs[v].y,vs[v].z,vs[v].facing,vs[v].map,weapons[j].p.name);
}
if(weapons[j].type=="rpg7")
{
spawn_rpg(vs[v].x,vs[v].y,vs[v].z,vs[v].facing,vs[v].map,weapons[j].p.name);
}
if(weapons[j].type=="gp30")
{
spawn_gp(vs[v].x,vs[v].y,vs[v].z,vs[v].facing,vs[v].map,weapons[j].p.name);
}
if(weapons[j].type=="ags30")
{
spawn_ags(vs[v].x,vs[v].y,vs[v].z,vs[v].facing,vs[v].map,weapons[j].p.name);
}
if(weapons[j].type=="m79_grenade_launcher")
{
spawn_grenade(vs[v].x,vs[v].y,vs[v].z,vs[v].facing,vs[v].map,weapons[j].p.name);
}
vs[v].hit(random(weapons[j].mindammage,weapons[j].maxdammage),weapons[j].p.name+"'s "+string_replace(weapons[j].type,"artillery","tank",false),t);

if(@weapons[j].p!=null)
{
send_reliable(weapons[j].p.peer_id,"play_s|"+(are_teamed(weapons[j].p.name, vs[v].owner)?"weaponpingteam":"weaponping")+".ogg",0);
if(weapons[j].type=="artillery") send_reliable(weapons[j].p.peer_id,"hit "+cn2n(vs[v].owner,true),2);
}
hit=true;
}
}
if(hit) { @weapons[j]=null;
 weapons.remove_at(j);
 break;
}
}
}
}
}
void spawn_weapon(double x, double y, double z, double dir, string type, string map,player@p1)
{
if(@p1==null) return;
weapon w1(x, y, z, dir, type, map, p1);
weapons.insert_last(w1);
}