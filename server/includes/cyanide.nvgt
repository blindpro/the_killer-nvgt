cyanide@[] cyanides(0);
class cyanide
{
double x,y,z;
string map, owner, hitowner;
timer starttimer, poisontimer;
int starttime = 1000;
int poisontime = 500;
int times;
int currenttimes;
int mindammage=1500;
int maxdammage=3000;
int mode = 0;
int spread = 5;
int dir=0;
cyanide(double cx, double cy, double cz, int cdir, string cmap, string cowner, string chitowner)
{
x=cx;
y=cy;
z=cz;
map=cmap;
owner=cowner;
hitowner=chitowner;
times=random(5,7);
dir=cdir;
}
}
void cyanideloop()
{
for(uint i = 0; i < cyanides.length(); i++)
{
if(cyanides[i].mode==0)
{
if(cyanides[i].starttimer.elapsed>=cyanides[i].starttime) cyanides[i].mode=1;
}
if(cyanides[i].mode==1)
{
if(cyanides[i].poisontimer.elapsed>=cyanides[i].poisontime)
{
cyanides[i].poisontimer.restart();
int index=get_player_index_from(cyanides[i].hitowner);
if(index>-1)
{
if(players[index].is_dead) cyanides[i].mode=2;
if(cyanides[i].x!=players[index].x) cyanides[i].x=players[index].x;
if(cyanides[i].y!=players[index].y) cyanides[i].y=players[index].y;
if(cyanides[i].z!=players[index].z) cyanides[i].z=players[index].z;
}
else cyanides[i].mode=2;
int blood_sound=random(1,4);
for(uint j = 0; j < players.length(); j++)
{
if(get_3d_distance(cyanides[i].x,cyanides[i].y,cyanides[i].z,players[j].x,players[j].y,players[j].z)<=cyanides[i].spread&&cyanides[i].map==players[j].map)
{
if(in_vehicle(players[j].name)>-1 or players[j].newb==1 or players[j].is_dead or players[j].invinsible or players[j].mask==1) continue;
players[j].hit(cyanides[i].mindammage,cyanides[i].maxdammage,false);
players[j].playsound("blood"+blood_sound);
players[j].should_subtract=true;
players[j].hitby = cyanides[i].owner+"'s cyanide";
}
}
cyanides[i].currenttimes++;
if(cyanides[i].currenttimes>=cyanides[i].times) cyanides[i].mode=2;
}
}
if(cyanides[i].mode==2)
{
@cyanides[i]=null;
cyanides.remove_at(i);
break;;
}
}
}
void spawn_cyanide(double x, double y, double z, int dir, string map, string owner, string hitowner)
{
cyanide c(x,y,z,dir,map,owner,hitowner);
cyanides.insert_last(c);
}