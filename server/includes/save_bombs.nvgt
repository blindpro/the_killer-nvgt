void save_bombs()
{
if(file_exists("prefs/save_bombs.dat")) file_delete("prefs/save_bombs.dat");
json_array@ bomb_a = null;
json_object bomb_type;
@bomb_a = create_json_array_from_mine();
if(bomb_a.size()>0) bomb_type.set("mines",bomb_a);
@bomb_a = create_json_array_from_motion_bomb();
if(bomb_a.size()>0) bomb_type.set("motion_bombs",bomb_a);
@bomb_a = create_json_array_from_wirebomb();
if(bomb_a.size()>0) bomb_type.set("wirebombs",bomb_a);
@bomb_a = create_json_array_from_security_bomb();
if(bomb_a.size()>0) bomb_type.set("security_bombs",bomb_a);
if(bomb_type.size()>0)
{
fl.open("prefs/save_bombs.dat","wb");
fl.write(bomb_type.stringify());
fl.close();
}
}
void load_bombs()
{
if(file_exists("prefs/save_bombs.dat")==false) return;
fl.open("prefs/save_bombs.dat","rb");
json_object@ bomb_type = parse_json(fl.read());
fl.close();
file_delete("prefs/save_bombs.dat");
if(bomb_type.exists("mines")) create_mine_from_json_array(bomb_type["mines"]);
if(bomb_type.exists("motion_bombs")) create_motion_bomb_from_json_array(bomb_type["motion_bombs"]);
if(bomb_type.exists("security_bombs")) create_security_bomb_from_json_array(bomb_type["security_bombs"]);
if(bomb_type.exists("wirebombs")) create_wirebomb_from_json_array(bomb_type["wirebombs"]);
}