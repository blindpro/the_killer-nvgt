int hour=0, minute=1, day=1, month=1, year=2000;
int timetime=1500;
timer timetimer;
void timeloop()
{
if(timetimer.elapsed > timetime)
{
timetimer.restart();
minute++;
foodcheck();
}
if(minute>59)
{
minute=0;
hour++;
checktime();
foodcheck();
}
if(hour>23)
{
hour=0;
minute=0;
day+=1;
if (day>31)
{
day=1;
month+=1;
if (month>12)
{
month=1;
year+=1;
}
}
}
}
