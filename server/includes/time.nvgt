void checktime()
{
}
string convert_month(int m)
{
string ret;
if(m==1)
ret="January";
else if(m==2)
ret="February";
else if(m==3)
ret="March";
else if(m==4)
ret="April";
else if(m==5)
ret="May";
else if(m==6)
ret="June";
else if(m==7) ret="July";
else if(m==8)
ret="August";
else if(m==9)
ret="September";
else if(m==10)
ret="October";
else if(m==11)
ret="November";
else if(m==12)
ret="December";
else
ret="Unknown";
return ret;
}
string gettime()
{
int newhour;
string newminute;
string ampm;
if (hour<=12 and hour>=0)
{
newhour=hour;
ampm="AM";
}
else
{
ampm="PM";
newhour=hour-12;
}
if (minute<10)
newminute="0"+minute;
else
newminute=minute;
return newhour+":"+newminute+" "+ampm+", "+convert_month(month)+" "+day+", "+year;
}
