int64 stn (string number)
{
	return parse_double (number);
}
string convert_to_list(string[] arr)
{
string list;
if(arr.length()==0) return "";
if(arr.length()==1) return arr[0];
for(uint i=0; i<arr.length(); i++)
{
if(i==arr.length()-1)
list+=" and "+arr[i];
else
list+=arr[i]+", ";
}
return list;
}
string convert_to_list(int[] arr)
{
string list;
if(arr.length()==0) return "";
if(arr.length()==1) return arr[0];
for(uint i=0; i<arr.length(); i++)
{
if(i==arr.length()-1)
list+=" and "+arr[i];
else
list+=arr[i]+", ";
}
return list;
}

//I don't know why GitHub changed our encoding.
string[] split_text (string text , string split1, string split2 =string split1)
{
string[] list = text.split (split1);
if (list.length() <=1)
{
list = text.split (split2);
}
return list;
}
json_array@ vara_to_jsona(string[]@ v)
{
json_array a;
for(uint i = 0; i < v.length(); i++)
{
a.add(v[i]);
}
if(a.size()<=0) return null;
return a;
}