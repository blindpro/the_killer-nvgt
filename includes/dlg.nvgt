void dlg(string message)
{
say (message);
while(true)
{
if(connected) tk_loop();
if (key_pressed(KEY_LEFT) or key_pressed(KEY_RIGHT) or key_pressed(KEY_UP) or key_pressed(KEY_DOWN))
{
say (message);
}
if (key_pressed(KEY_RETURN) or key_pressed(KEY_ESCAPE))
{
break;
}
wait(5);
}
}

void dlg_wait(string message, int waittime)
{
say (message);
timer d;
while(true)
{
if(connected) tk_loop();
if (key_pressed(KEY_LEFT) or key_pressed(KEY_RIGHT) or key_pressed(KEY_UP) or key_pressed(KEY_DOWN))
{
say (message);
}
if(d.elapsed>=waittime)
{
break;
}
wait(5);
}
}

void dlg_audio (string file_name , string message = "")
{
sound p;
p.load (file_name);
p.play();
if(message!="") say (message);
while(p.playing)
{
if(connected) tk_loop();
if (message!="" and key_pressed(KEY_LEFT) or key_pressed(KEY_RIGHT) or key_pressed(KEY_UP) or key_pressed(KEY_DOWN))
{
say (message);
}
if (key_pressed(KEY_RETURN) or key_pressed(KEY_ESCAPE))
{
fade(p);
break;
}
wait(5);
}
}