string[] sl;

// ✅ 改名：避免和你环境已有全局属性冲突
string g_src_text;
string g_trans_text;

void speak_length_start()
{
    string s;
    file f;
    f.open("dictionary.txt","rb");
    s = f.read();
    f.close();
    sl = split_text(s, "\r\n", "\n");
}

string trim_str(string x)
{
    int a = 0, b = x.length();
    while (a < b) {
        string ch = x[a];
        if (ch==' '||ch=='\t'||ch=='\r'||ch=='\n') a++;
        else break;
    }
    while (b > a) {
        string ch = x[b-1];
        if (ch==' '||ch=='\t'||ch=='\r'||ch=='\n') b--;
        else break;
    }
    return (b > a) ? x.substr(a, b-a) : "";
}

void parse_template(const string&in tpl, string[]&out literals, int[]&out nums)
{
    literals.resize(0);
    nums.resize(0);

    string cur = "";
    int i = 0;

    while (i < tpl.length())
    {
        string ch = tpl.substr(i, 1);
        if (ch == "%" && i + 1 < tpl.length())
        {
            int j = i + 1;
            int num = 0;
            int got = 0;

            while (j < tpl.length())
            {
                int d = stn(tpl.substr(j, 1));
                if (d >= 0 && d <= 9) { num = num * 10 + d; got = 1; j++; }
                else break;
            }

            if (got == 1)
            {
                literals.insert_last(cur);
                cur = "";
                nums.insert_last(num);
                i = j;
                continue;
            }
        }

        cur += ch;
        i++;
    }

    literals.insert_last(cur);
}

bool match_and_capture(const string&in text, const string&in src, string[]&out args)
{
    string[] lits;
    int[] nums;
    parse_template(src, lits, nums);

    if (nums.length() == 0)
    {
        args.resize(0);
        return (text == src);
    }

    int maxNum = -1;
    for (int k = 0; k < int(nums.length()); k++) if (nums[k] > maxNum) maxNum = nums[k];
    args.resize(maxNum + 1);
    for (int z = 0; z < int(args.length()); z++) args[z] = "";

    string lit0 = lits[0];
    if (lit0.length() > 0)
    {
        if (text.length() < lit0.length()) return false;
        if (text.substr(0, lit0.length()) != lit0) return false;
    }

    int pos = lit0.length();

    for (int i = 0; i < int(nums.length()); i++)
    {
        int n = nums[i];
        string nextLit = lits[i + 1];

        if (nextLit.length() == 0)
        {
            string cap = text.substr(pos, text.length() - pos);
            args[n] = cap;
            pos = text.length();
            continue;
        }

        int found = -1;
        for (int p = pos; p + nextLit.length() <= text.length(); p++)
        {
            if (text.substr(p, nextLit.length()) == nextLit) { found = p; break; }
        }
        if (found < 0) return false;

        string cap2 = text.substr(pos, found - pos);
        args[n] = cap2;

        pos = found + nextLit.length();
    }

    if (pos != text.length()) return false;
    return true;
}

string speak_length(string text)
{
    for (int i = 0; i < int(sl.length()); i++)
    {
        string line = trim_str(sl[i]);
        if (line.length() == 0) continue;

        int sep = -1;
        int byBracket = 0;
        for (int p = 0; p + 2 < line.length(); p++) {
            if (line.substr(p, 3) == "[=]") { sep = p; byBracket = 1; break; }
        }
        if (sep < 0) {
            for (int q = 0; q < line.length(); q++) {
                if (line.substr(q, 1) == "=") { sep = q; byBracket = 0; break; }
            }
        }
        if (sep < 0) continue;

        string src = trim_str(line.substr(0, sep));
        string dst = trim_str(line.substr(sep + (byBracket == 1 ? 3 : 1)));
        if (src.length() == 0) continue;

        string[] args;
        if (match_and_capture(text, src, args))
        {
            // 用 format 输出（假设 format 支持 %0 %1...）
            return dst.format(args);
        }
    }

    return text;
}

string translation_callback(const string&in text)
{
    g_src_text = text;
    g_trans_text = speak_length(g_src_text);
    return g_trans_text;
}

void copy_translation_text_loop()
{
    if (key_pressed(KEY_F12))
    {
        if (key_down(KEY_LALT) || key_down(KEY_RALT))
        {
            clipboard_set_text(g_src_text);
            speak("copy");
        }
        else
        {
            clipboard_set_text(g_trans_text);
            speak("copy");
        }
    }
}
