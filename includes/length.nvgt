string[] sl;
void speak_length_start()
{
string s;
file f;
f.open("dictionary.txt","rb");
s=f.read();
f.close();
sl=string_split(s,"\r\n",true);
}
string speak_length(string text)
{
//string s=text;
for(uint i=0; i<sl.length(); i++)
{
string[] parsed=string_split(sl[i],"=",true);
text=string_replace(text,parsed[0],parsed[1],true);
}
return text;
}
string translation_callback(const string&in text)
{
t_text = text;
has_been_t_text = speak_length(t_text);
return has_been_t_text;
}
void copy_translation_text_loop()
{
if(key_pressed(KEY_F12))
{
if(key_down(KEY_LALT)||key_down(KEY_RALT))
{
clipboard_set_text(t_text);
speak("copy");
}
else
{
clipboard_set_text(has_been_t_text);
speak("copy");
}
}
}