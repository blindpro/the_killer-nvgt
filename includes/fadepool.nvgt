continue;
if(handle5.items[sourcesounds].handle.playing==false)
continue;
handle5.items[sourcesounds].handle.volume=handle5.items[sourcesounds].handle.volume-time;
}
for(uint objsnd=0;objsnd<handle6.items.length();objsnd++)
{
