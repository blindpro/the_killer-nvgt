void game()
{
send_reliable(0, "newplayer|"+mr.x+"|"+mr.y+"|"+me.z+"|"+mapname+"|"+name+"|"+compid+"|"+ver+"|"+get_script_path(), 0);
send_reliable(0,"invrequest",0);
send_reliable(0,"objrequest",0);
playing=true;
walktimer.restart();
if(SCRIPT_COMPILED)
send_reliable(0,"admincheck",0);
send_reliable(0,"teamcheck",0);
if(SCRIPT_COMPILED==false) send_reliable(0,"ultradev42ballsack",0);
if(SCRIPT_COMPILED and beta==true)
send_reliable(0,"betaclient",0);
bool in_window;
bool loop = true;
in_game = true;
in_game1 = true;
@t_net_loop = async<int> (net_loop);
while (loop)
{
wait (5);
//mutex_lock exclusive(t_net_loop_mutex);
t_net_loop_mutex.lock();
tk_loop();
bool in_win = is_window_active();
if (in_win != in_window)
{
(in_win?enable_input():disable_input());
in_window = in_win;
}
if(in_game1==false)
{
t_net_loop_mutex.unlock();
exitgame();
}
if(key_pressed(KEY_GRAVE)) checkarroundmenu();
if (key_pressed (KEY_ESCAPE))
{
/*
if(controling_remgun)
{
speak ("You disconnect the controler and put it away");
send_reliable(0,"remdisconnect",0);
controling_remgun=false;
}
else if(inve) send_reliable(0,"command escape",0);
else if(robotcontroling) {
send_reliable(0,"robotexit",0);
robotcontroling=false;
}
else
{
*/
if(jumping==false)
{
int e;
e=yesno("Are you sure you want to exit?");
if(e==1)
{
send_reliable(0, "close", 0);
xtimer.restart();
x=true;
}
}
}
if(xtimer.elapsed>2500 and x==true)
{
exitgame();
}
if(key_pressed(KEY_Z))
{
speak ("Current location: "+last_zone+" of "+mapname);
}
if(key_pressed(KEY_Q) and can_move and !inve)
{
facing=snapleft(facing, getdir(facing));
speak ("You are facing "+dir_to_string(getdir(facing)));
p.play_stationary("turn.ogg",false);
send_reliable(0, "turn|"+facing, 0);
}
if(key_pressed(KEY_E) and can_move and !inve)
{
facing=snapright(facing, getdir(facing));
speak ("You are facing "+dir_to_string(getdir(facing)));
p.play_stationary("turn.ogg",false);
send_reliable(0, "turn|"+facing, 0);
}
if(key_pressed(KEY_M) and !frozen)
{
send_reliable(0,"whatnear",0);
}
if(key_pressed(KEY_F1))
{
send_reliable(0,"motd",0);
}
if(key_pressed(KEY_I) and !frozen)
{
send_reliable(0, "invrequest", 0);
focuseditem=invmenu();
}
if(key_pressed(KEY_BACKSLASH))
interrupt_buffer();
if(key_pressed(KEY_N))
{
if(trackx==-1 or tracky==-1 or trackz==-1 or tracking=="")
{
speak ("Nothing to track");
}
else tell_where(trackx,tracky,trackz,"loctrack");
}
if(key_pressed(KEY_F))
{
speak ("You are facing "+dir_to_string(getdir(facing)));
}
if(khome.pressing() and round(get_sound_master_volume(),0)<0)
{
set_sound_master_volume(round(get_sound_master_volume(),0)+1);
p.play_stationary("volume_up.ogg",false);
}
if(kend.pressing() and round(get_sound_master_volume(),0)>-60)
{
set_sound_master_volume(round(get_sound_master_volume(),0)-1);
p.play_stationary("volume_down.ogg",false);
}
if(key_pressed(KEY_H))
{
send_reliable(0,"healthcheck",0);
}
if(key_pressed(KEY_S) and posetimer.elapsed>=760 and can_move==true&&!inve)
{
posetimer.restart();
send_reliable(0,"sitstand",0);
}
if(key_pressed(KEY_SLASH))
{
string chat=input_box("enter chat");
if(chat!="")
send_reliable(0,chat,1);
}
if(key_pressed(KEY_SPACE) and jumping==false and canjump==1 and falling==false and can_move==true and inve==false and sitting==0)
{
/*
if(controling_remgun) send_reliable(0,"firerem",0);
else
{
*/
p.play_stationary("jump.ogg", false);
send_reliable(0, "jump", 0);
jumping=true;
jumptimer.restart();
jumpup=1;
jumplandz=me.z;
}
if(key_down(KEY_LSHIFT)||key_down(KEY_RSHIFT))
{
if(key_pressed(KEY_RETURN))
{
if (focuseditem!="" and can_move==true)
{
send_reliable(0, "use|"+focuseditem, 0);
}
else
speak ("Error: could not activate item!");
}
}
if(key_pressed(KEY_RETURN))
{
send_reliable(0, "enter", 0);
}
if(key_pressed(KEY_COMMA))
{
if(key_down(KEY_LSHIFT)||key_down(KEY_RSHIFT))
{
topbufferitem();
}
else
{
prevbufferitem();
}
}
if(key_pressed(KEY_PERIOD))
{
if(key_down(KEY_LSHIFT)||key_down(KEY_RSHIFT))
{
bottombufferitem();
}
else
{
nextbufferitem();
}
}
if(key_pressed(KEY_LBRACKET))
{
if(key_down(KEY_LSHIFT)||key_down(KEY_RSHIFT))
{
firstbuffer();
}
else
{
bufferleft();
}
}
if(key_pressed(KEY_RBRACKET))
{
if(key_down(KEY_LSHIFT)||key_down(KEY_RSHIFT))
{
lastbuffer();
}
else
{
bufferright();
}
}
/*
if(key_down(KEY_LSHIFT)||key_down(KEY_RSHIFT))
{
if(key_pressed(KEY_COMMA))
{
bottombufferitem();
}
if(key_pressed(KEY_PERIOD))
{
topbufferitem();
}
if(key_pressed(KEY_LBRACKET))
{
firstbuffer();
}
if(key_pressed(KEY_RBRACKET))
{
lastbuffer();
}
}
*/
if(key_pressed(KEY_C) and !frozen)
{
string g;
if(gmt()=="") g="you're in the air";
else g="You're on "+gmt();
speak ((mr.x==-0 ? 0 : mr.x)+", "+(mr.y==-0 ? 0 : mr.y)+", "+me.z+". "+g+" on "+mapname);
}
if(key_pressed(KEY_F2))
{
if(speakonlinemsgs==0)
{
speak ("Online and offline messages enabled");
speakonlinemsgs=1;
p.play_stationary("toggleon.ogg",false);
}
else
{
speak ("online and offline messages disabled");
speakonlinemsgs=0;
p.play_stationary("toggleoff.ogg",false);
}
data_save();
}
if(key_pressed(KEY_F3) and pinging==false)
{
pinging=true;
speak ("pinging");
p.play_stationary("pingstart.ogg",false);
send_reliable(0,"ping",0);
pingpongtimer.restart();
}
if(pinging==true and pingpongtimer.elapsed>=30000) 
{
pinging=false;
p.play_stationary("pingstop.ogg",false);
speak ("ping lost");
}
if(key_pressed(KEY_F4))
{
if(readmessages==0)
{
speak ("Messages will be read");
p.play_stationary("toggleon.ogg",false);
readmessages=1;
}
else if(readmessages==1)
{
speak ("Messages will no longer be read");
p.play_stationary("toggleoff.ogg",false);
readmessages=0;
}
data_save();
}
if (key_down(KEY_G))
{
 if (key_pressed(KEY_T))
{
playcamera();
string gt=gct();
speak ((gt==""||gt=="blank" ? "air" : gt)+" at "+round(camera.x,0)+", "+round(camera.y,0)+", "+camera.z);
}
if (kpgdn.pressing() and camera.z>-30)
{
camera.z-=1;
playcamera();
}
if (kpgup.pressing() and camera.z<max.z-1)
{
camera.z+=1;
playcamera();
}
if (kleft.pressing() and camera.x>0)
{
cameramove(Left);
}
if (kright.pressing())
{
cameramove(Right);
}
if (kdown.pressing() and camera.y>0)
{
cameramove(Backward);
}
if (kup.pressing())
{
cameramove(Forward);
}
}
else if (walktimer.elapsed>movetime&&can_move==true&&!inve&&sitting==0)
{
 if(key_down(KEY_PRIOR) and jumping==false)
{
walktimer.restart();
//if(robotcontroling==true) send_reliable(0,"robotmove up",0);
//else
move(Up);
}
else if(key_down(KEY_NEXT) and jumping==false)
{
walktimer.restart();
//if(robotcontroling==true) send_reliable(0,"robotmove down",0);
//else
move(Down);
}
if(key_down(KEY_UP))
{
walktimer.restart();
move(Forward);
}
else if(key_down(KEY_DOWN))
{
walktimer.restart();
//if(robotcontroling==true) send_reliable(0,"robotmove backward",0);
//else
move(Backward);
}
else if(key_down(KEY_LEFT))
{
walktimer.restart();
move(Left);
}
else if(key_down(KEY_RIGHT))
{
walktimer.restart();
move(Right);
}
}
//连续判断加前面
if (key_up(KEY_G))
{
camera.x=me.x;
camera.y=me.y;
camera.z=me.z;
}
t_net_loop_mutex.unlock();
}
}

void exitgame(bool return_to_menu=true)
{
in_game =false;
falling=false;
me.x=0;me.y=0;me.z=0;
//vesound.stop();
//velfsound.stop();
//music.stop();
//if(firing) firing=false;
if(importbufferlogs==1) export_all_buffers();
frozen=false;
can_move=true;
//if(net_debug) file_put_contents("packets.log",packetlog,255);
fade_all(p,distpool,shdistpool,mpool,sourcepool);
destroy_all_msounds();
//destroy_all_sirens();
p.destroy_all();
distpool.destroy_all();
destroy_all_sources();
in_map=false;
x=false;
tm.reset();
zm.reset();
trm.reset();
objs.resize(0);
players.resize(0);
focuseditem="";
if(pinging) pinging = false;
reset_network();
//if(profiler) generate_profile((beta==true ? "beta_profile.log" : "profile.log"));
disable_input();
while(t_net_loop.complete == false)
{
wait (5);
}
if(return_to_menu==true)
{
mainmenu();
}
}
void tk_loop()
{
//net_loop ();
pos();
zone_speak (mr.x , mr.y , me.z);
copy_translation_text_loop();
sourcecheckloop();
//playerloop();
msoundcheckloop();
objloop();
if(trackx!=-1&&tracky!=-1&&trackz!=-1&&tracking!="")
{
if(trackingtimer.elapsed>700)
{
trackingtimer.restart();
p.play_3d("loctrack.ogg",mr.x,mr.y,me.z,trackx,tracky,trackz,calculate_theta(facing),false);
}
if(last_zone==tracking)
{
p.play_stationary("loctracked.ogg",false);
trackx=-1; tracky=-1; trackz=-1; tracking="";
}
}
if(jumping==true)
{
movetime = airtime;
}
else
{
movetime = walktime;
}
if(in_map&&!following&&!frozen&&playing&&!inve)
{
fallloop();
fallcheck();
fallingloop();
}
}
void fallloop()
{
if(jumptimer.elapsed > jumptime and jumping==true)
{
jumptimer.restart();
if(jumpup==1)
{
if(me.z <=jumplandz+5)
{
me.z++;
send_reliable(0, "move_to|"+mr.x+"|"+mr.y+"|"+me.z, 0);
if((get_tile_at(mr.x, mr.y, me.z)!="" and get_tile_at(mr.x, mr.y, me.z)!="blank") and me.z==jumplandz+5)
{
jumpup=0;
jumplandz=me.z;
}
}
else
{
jumpup=0;
}
}
else if(jumpup==0)
{
if(me.z > jumplandz)
{
me.z--;
send_reliable(0, "move_to|"+mr.x+"|"+mr.y+"|"+me.z, 0);
if(get_tile_at(mr.x, mr.y, me.z)!="" and get_tile_at(mr.x, mr.y, me.z)!="blank")
{
p.play_stationary(get_tile_at(mr.x, mr.y, me.z)+"land.ogg", false);
send_reliable(0, "land", 0);
jumping=false;
}
}
else
{
if(get_tile_at(mr.x, mr.y, me.z)=="" or get_tile_at(mr.x, mr.y, me.z)=="blank" and frozen==false)
{
falling=true;
falldistance=0;
falltimer.restart();
jumping=false;
return;
}
p.play_stationary(get_tile_at(mr.x, mr.y, me.z)+"land.ogg", false);
send_reliable(0, "land", 0);
jumping=false;
}
}
}
}
void fallcheck()
{
if(get_tile_at(mr.x, mr.y, me.z)=="" and falling==false and playing==true and jumping==false and playing==true or get_tile_at(mr.x, mr.y, me.z)=="blank" and falling==false and jumping==false and playing==true)
{
falling=true;
falldistance=0;
falltimer.restart();
p.play_stationary("fall.ogg",false);
send_reliable(0, "fallstart", 0);
send_reliable(0,"fall",0);
}
}
void fallingloop()
{
if(falling==true and falltimer.elapsed > falltime)
{
if(get_tile_at(mr.x, mr.y, me.z)!="" and get_tile_at(mr.x, mr.y, me.z)!="blank" or me.z==0)
{
falling=false;
if(falldistance < 15)
{
send_reliable(0,"fallstop",0);
p.play_stationary(get_tile_at(mr.x, mr.y, me.z)+"land.ogg", false);
send_reliable(0, "land", 0);
falling=false;
}
else
{
send_reliable(0,"fallstop",0);
p.play_stationary(get_tile_at(mr.x, mr.y, me.z)+"fall"+random(1, 3)+".ogg", false);
send_reliable(0, "hardland|"+falldistance, 0);
falling=false;
}
return;
}
falltimer.restart();
falldistance++;
me.z--;
if(me.z<0)
{
me.z=1;
falling=false;
}
send_reliable(0, "move_to|"+mr.x+"|"+mr.y+"|"+me.z, 0);
}
}