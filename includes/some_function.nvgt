int stn (string number)
{
	return string_to_number (number);
}
string get_script_path()
{
string scriptpath;
if(SCRIPT_COMPILED==false)
{
scriptpath=SCRIPT_CURRENT_FILE;
}
else
{
scriptpath=SCRIPT_EXECUTABLE;
}
return scriptpath;
}
bool is_sound_number(string t)
{
t=string_replace(t, ".", "", true);
t=string_replace(t, "-", "", true);
if(string_is_digits(t))
return true;
return false;
}
bool is_sound_exists(string s)
{
string[] filelist=cast<pack_file@>(sound_default_pack).list_files();
for(uint i = 0; i < filelist.length(); i++)
{
if(s==filelist[i])
{
return true;
}
}
return false;
}
bool get_total_distance(double sx,double sy,double sz,double tx,double ty,double tz,int mindist=20)
{
return (sx<tx+mindist and sx>tx-mindist and sy<ty+mindist and sy>ty-mindist and sz<tz+mindist and sz>tz-mindist);
}
string input_box(string title)
{
disable_input();
audio_form f;
f.create_window("",false,false);
int box_text = f.create_input_box(title,"","",0,false,true,false);
int ok = f.create_button("ok",true);
int cancel = f.create_button("cancel",false,true);
f.focus(box_text);
while (true)
{
wait (5);
tk_loop(true);

f.monitor();
if(f.is_pressed(ok))
{
string text = f.get_text(box_text);
if(text=="")
{
f.focus(box_text);
}
else
{
enable_input();
return text;
}
}
else if(f.is_pressed(cancel))
{
enable_input();
speak ("canceled");
return "";
}
}
return "";
}
void tell_where(int x, int y, int z, string soundname, bool include_locations=false)
{
if(z>me.z)
go="above, ";
else if(z<me.z)
go="below, ";
go4=calculate_x_y_string(calculate_x_y_angle(mr.x,mr.y,x,y,facing));
string boing="";
if(include_locations==true)
{
boing=" in "+get_zone(x,y,z)+" ";
}
int dist=get_3d_distance(mr.x,mr.y,me.z,x,y,z);
speak (go+go4+" ("+dist+" tiles away) "+boing+"at "+x+", "+y+", "+z);
p.play_3d(soundname+".ogg",mr.x,mr.y,me.z,x,y,z,calculate_theta(facing),false);
go="";
}
bool shift_is_down()
{
if(key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT))
{
return true;
}
return false;
}
bool alt_is_down()
{
if(key_down(KEY_LALT) or key_down(KEY_RALT))
{
return true;
}
return false;
}
bool control_is_down()
{
if(key_down(KEY_LCONTROL) or (key_down(KEY_RCONTROL)&&rcontrol==1))
{
return true;
}
return false;
}
bool control_is_pressed()
{
if(key_pressed(KEY_LCONTROL) or (key_pressed(KEY_RCONTROL)&&rcontrol==1))
{
return true;
}
return false;
}

//I don't know why GitHub changed our encoding.
string[] split_text (string text , string split1, string split2 =string split1)
{
string[] list = text.split (split1);
if (list.length() <=1)
{
list = text.split (split2);
}
return list;
}