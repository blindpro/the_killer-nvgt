string[] sl;
void speak_length_start()
{
string s;
file f;
f.open("dictionary.txt","rb");
s=f.read();
f.close();
sl=split_text (s,"\r\n","\n");
}

string speak_length(string text)
{
    for (int i = 0; i < int(sl.length()); i++)
    {
        string line = sl[i];

        // —— trim 当前行 ——
        int a = 0, b = line.length();
        while (a < b) { 
string ch = line[a];
if (ch==' '||ch=='\t'||ch=='\r'||ch=='\n') a++;
else break;
}
        while (b > a)
{
string ch = line[b-1];
if (ch==' '||ch=='\t'||ch=='\r'||ch=='\n') b--;
else break;
}
        if (b <= a) continue;
        line = line.substr(a, b - a);

        // —— 找分隔符：优先 [=]，否则 "=" ——
        int sep = -1;
        int byBracket = 0;
        for (int p = 0; p + 2 < line.length(); p++) {
            if (line.substr(p, 3) == "[=]") { sep = p; byBracket = 1; break; }
        }
        if (sep < 0) {
            for (int q = 0; q < line.length(); q++) {
                if (line.substr(q, 1) == "=") { sep = q; byBracket = 0; break; }
            }
        }
        if (sep < 0) continue;

        string src = line.substr(0, sep);
        string dst = line.substr(sep + (byBracket == 1 ? 3 : 1));

        // —— 再各自 trim ——
        a = 0; b = src.length();
        while (a < b) { string c2 = src[a]; if (c2==' '||c2=='\t'||c2=='\r'||c2=='\n') a++; else break; }
        while (b > a) { string c3 = src[b-1]; if (c3==' '||c3=='\t'||c3=='\r'||c3=='\n') b--; else break; }
        if (b <= a) continue;
        src = src.substr(a, b - a);

        a = 0; b = dst.length();
        while (a < b) { string c4 = dst[a]; if (c4==' '||c4=='\t'||c4=='\r'||c4=='\n') a++; else break; }
        while (b > a) { string c5 = dst[b-1]; if (c5==' '||c5=='\t'||c5=='\r'||c5=='\n') b--; else break; }
        dst = (b > a) ? dst.substr(a, b - a) : "";

        if (src.length() == 0) continue;

        // —— 把 src 模板 → 正则，记录“参数编号出现顺序”（paramNums）——
        string rx = "^";
        int[] paramNums; // 捕获组的顺序（第k个捕获组对应的“参数编号”）
        int idx = 0;
        while (idx < src.length()) {
            string chs = src[idx];
            if (chs == '%' && idx + 1 < src.length()) {
                int j = idx + 1, num = 0, got = 0;
                while (j < src.length()) {
                    string d = src[j];
                    if (stn(d) >= 0 && stn(d) <= 9) { num = num * 10 + (stn(d) - 0); got = 1; j++; }
                    else break;
                }
                if (got == 1) {
                    rx += "(.*?)";             // 非贪婪捕获，允许空
                    paramNums.insert_last(num); // 记录这个捕获组对应的参数编号
                    idx = j; continue;
                }
            }
            // 逐字符转义正则元字符 . ^ $ | ( ) [ ] { } * + ? \
            string t = src.substr(idx, 1);
            if (t=="."||t=="^"||t=="$"||t=="|"||t=="("||t==")"||t=="["||t=="]"||t=="{"||t=="}"||t=="*"||t=="+"||t=="?"||t=="\\")
                rx += "\\" + t;
            else
                rx += t;
            idx++;
        }
        rx += "$";

        // —— 把 dst 模板里的 %n → $rank（rank 为该参数在 src 中第几号捕获组）——
        string repl = "";
        idx = 0;
        while (idx < dst.length()) {
            string chd = dst[idx];
            if (chd == '%' && idx + 1 < dst.length()) {
                int j2 = idx + 1, num2 = 0, got2 = 0;
                while (j2 < dst.length()) {
                    string d2 = dst[j2];
                    if (stn(d2) >= 0 && stn(d2) <= 9) { num2 = num2 * 10 + (stn(d2) - 0); got2 = 1; j2++; }
                    else break;
                }
                if (got2 == 1) {
                    // 找到 num2 在 paramNums 中的第一次出现位置
                    int rank = 0;
                    for (int r = 0; r < int(paramNums.length()); r++) {
                        if (paramNums[r] == num2) { rank = r + 1; break; }
                    }
                    if (rank > 0) {
                        // 手工把 rank 转成十进制字符串
                        string numRank = "";
                        int tmp = rank;
                        string rev = "";
                        while (tmp > 0) { int dig = tmp % 10; rev += string(0 + dig); tmp /= 10; }
                        for (int k = rev.length() - 1; k >= 0; k--) numRank += rev.substr(k, 1);
                        repl += "$" + numRank;
                    }
                    idx = j2; continue;
                }
            }
            repl += dst.substr(idx, 1);
            idx++;
        }

        // —— 正则替换（锚定 ^$，因此只会替换整串）——
        // 旗标：UTF-8 + 点号匹配换行（避免多行文本被截断）；不启用 MULTILINE，保持 ^/$ 匹配整串
        string converted = regexp_replace(text, rx, repl, RE_UTF8 | RE_DOTALL);
        if (converted != text) return converted; // 命中这一条规则
    }

    // 没命中任何规则：原样返回
    return text;
}

string translation_callback(const string&in text)
{
t_text = text;
has_been_t_text = speak_length(t_text);
return has_been_t_text;
}
void copy_translation_text_loop()
{
if(key_pressed(KEY_F12))
{
if(key_down(KEY_LALT)||key_down(KEY_RALT))
{
clipboard_set_text(t_text);
speak("copy");
}
else
{
clipboard_set_text(has_been_t_text);
speak("copy");
}
}
}